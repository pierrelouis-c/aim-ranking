# PostgreSQL connection (required)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# API server
PORT=3001
HOST=0.0.0.0

# CORS — comma-separated allowed browser origins (no trailing slash)
# Dev + prod example:
CORS_ORIGIN=http://localhost:5173,https://www.aim-ranking.com,https://aim-ranking.com

# Optional: max plausible score for anti-cheat (default 50000)
MAX_SCORE=50000
